DATABASE_URL=
# Scheduled backend work: use a random secret of at least 32 characters.
# Vercel automatically supplies it as a Bearer token to /api/jobs/daily.
CRON_SECRET=
# Evaluation only: set false before production to block the shared demo admin,
# including existing demo-admin sessions. Initial demo password is never reset.
ENABLE_DEMO_ADMIN=true

# Microsoft Entra ID / SSO placeholders
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use your organization's specific Entra tenant ID (not common/organizations).
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
